# Dados (nunca versionar: podem conter PII)
# (ignora todo o conteúdo, mas mantém a estrutura de pastas via .gitkeep)
data/**
!data/**/
!data/**/.gitkeep
# Dataset bruto: versionado porque a licença é CC0 (domínio público), para o avaliador
# rodar o projeto sem conta no Kaggle.
!data/raw/credit_risk_dataset.csv

# Segredos
.env
.env.*
!.env.example

# Modelos grandes
models/*.pkl
models/*.joblib
models/*.json
!models/.gitkeep

# Logs finais da execução versionados para auditoria
!logs/*.jsonl
!logs/.gitkeep

# Material de apresentação: apenas a página de demonstração é versionada.
!docs/apresentacao/
docs/apresentacao/*
!docs/apresentacao/demo/
docs/apresentacao/demo/shots/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# SO / IDE
.DS_Store
Thumbs.db
.idea/
