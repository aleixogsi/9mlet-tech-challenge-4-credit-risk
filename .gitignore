# Dados (nunca versionar: podem conter PII; ver context/02-convencoes.md)
# (ignora todo o conteúdo, mas mantém a estrutura de pastas via .gitkeep)
data/**
!data/**/
!data/**/.gitkeep
# Dataset bruto: versionado porque a licença é CC0 (domínio público), para o avaliador
# rodar o projeto sem conta no Kaggle (decisão D7).
!data/raw/credit_risk_dataset.csv

# Segredos
.env
.env.*
!.env.example

# Modelos grandes
models/*.pkl
models/*.joblib
models/*.json
!models/.gitkeep

# Logs finais da execução versionados para auditoria (T3.8)
!logs/*.jsonl
!logs/.gitkeep

# Material de apresentação: o deck e a edição do vídeo ficam locais (D14). A página de
# demonstração mostrada no vídeo é versionada, sem os prints de aprovação (D19).
!apresentacao/
apresentacao/*
!apresentacao/demo/
apresentacao/demo/shots/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Claude Code (configs pessoais)
.claude/settings.local.json

# SO / IDE
.DS_Store
Thumbs.db
.idea/
