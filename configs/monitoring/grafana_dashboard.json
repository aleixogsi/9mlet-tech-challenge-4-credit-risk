{
  "title": "Credit Risk — Observabilidade, Drift e Saúde",
  "uid": "credit-risk-phase4",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Share de Features com Drift por Janela",
      "type": "bargauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "credit_risk_share_drifted",
          "legendFormat": "{{window}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "ROC AUC e Queda de Performance por Janela",
      "type": "bargauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "credit_risk_auc",
          "legendFormat": "AUC {{window}}"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "credit_risk_auc_drop",
          "legendFormat": "Drop {{window}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Prediction Drift (PSI do Score) e Score Médio",
      "type": "bargauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "credit_risk_prediction_psi",
          "legendFormat": "PSI {{window}}"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "credit_risk_mean_score",
          "legendFormat": "Score Médio {{window}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Alertas Disparados por Janela, Tipo e Severidade",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "credit_risk_alerts_total",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Taxa de Aprovação e Latência p95 (ms)",
      "type": "bargauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "credit_risk_approval_rate",
          "legendFormat": "Taxa Aprovação {{window}}"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "credit_risk_latency_p95_ms",
          "legendFormat": "Latência p95 (ms) {{window}}"
        }
      ]
    }
  ]
}
